<Project>
  <!-- Shared by every project under src/. Built with the .NET 10 SDK, targeting .NET 8. -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>12</LangVersion>
    <Version>1.2.2</Version>
    <!-- A pre-release shows a yellow "Pre-release" box below About that explains what it means. -->
    <PreRelease>false</PreRelease>
    <Authors>KintaroModding</Authors>
    <Product>UE MM</Product>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Symbols live inside the assemblies, so a release is the exe and nothing else. -->
    <DebugType>embedded</DebugType>

    <!-- The catalog: the openmods page, which lists the game's mods from openmods.nexus. Its code is
         always built in; this switch shows the page and lets it go online. Off for now. -->
    <Catalog>false</Catalog>
  </PropertyGroup>

  <ItemGroup>
    <!-- The switches, as AppInfo reads them. -->
    <AssemblyMetadata Include="Catalog" Value="$(Catalog)" />
    <AssemblyMetadata Include="PreRelease" Value="$(PreRelease)" />
  </ItemGroup>

  <Target Name="CheckCatalogSwitch" BeforeTargets="BeforeBuild">
    <Error Condition="'$(Catalog)' != 'true' And '$(Catalog)' != 'false'"
           Text="Catalog '$(Catalog)' is unknown. Use true or false." />
  </Target>
</Project>
