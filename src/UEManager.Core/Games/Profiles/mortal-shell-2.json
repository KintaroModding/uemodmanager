// Game profile for Mortal Shell II. Used for test builds only, to try the manager
// against a released Unreal Engine 5 game:
//   dotnet publish src/UEManager.UI/UEManager.UI.csproj -p:GameProfile=mortal-shell-2
//
// Layout as documented by the game's mod pages: <install>\MortalShell2\Content\Paks\~mods.
// "executable" is left out: without Steam, the manager starts the exe it finds in the
// install folder.
{
  "id": "mortal-shell-2",
  "displayName": "Mortal Shell II",
  "developer": "Cold Symmetry",
  "tagline": "Test build: the manager pointed at Mortal Shell II to check detection, install, enable, disable and uninstall.",

  "steamAppId": "2584270",

  // Same UE4SS download page as the Phantom Blade Zero build, so the guide can be tried here.
  "ue4ssDownloadUrl": "https://github.com/KintaroModding/ue4ss/releases",
  "ue4ssManifestUrl": "https://raw.githubusercontent.com/KintaroModding/metadata/main/uemodmanager/manifest.json",
  // Fallback when the manifest cannot be reached: the Mortal Shell II build and its SHA-256 from SHA256SUMS.txt.
  "ue4ssPackageUrl": "https://github.com/KintaroModding/ue4ss/releases/download/v3.0.1-1181-g83330635/mortalshell2_ue4ss_v3.0.1-1181-g83330635.zip",
  "ue4ssPackageSha256": "A155C673506D34AA78E4C20579E39DAB35F62CB68EA04D4263E5EAE39066AC4A",

  "projectFolder": "MortalShell2",
  "paksPath": "{Project}/Content/Paks",
  "modsPath": "{Project}/Content/Paks/~mods"
}
