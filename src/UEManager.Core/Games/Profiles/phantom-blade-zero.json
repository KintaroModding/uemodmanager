// Game profile for Phantom Blade Zero. Built into the exe: change it here and rebuild.
//
// The folder layout below is the one of the released game, read from the Steam
// install on 2026-10-29. The Epic Games Store install is not checked yet.
//
// Paths are relative to the game's install folder. {Project} stands for the
// Unreal project folder. If that folder does not exist in an install found through
// Steam or Epic, the manager uses any folder in the install that holds Content/Paks.
// A folder chosen by hand must hold Engine, the project folder and the game's exe.
{
  "id": "phantom-blade-zero",
  "displayName": "Phantom Blade Zero",
  "developer": "S-GAME",
  "tagline": "Install, enable and remove packaged mods safely. Every file placed in the game is tracked, and files the manager did not place are never touched.",

  "steamAppId": "4115450",
  "epicDisplayName": "Phantom Blade Zero",

  "projectFolder": "ProjectPBZ",
  "paksPath": "{Project}/Content/Paks",
  "modsPath": "{Project}/Content/Paks/~mods",

  // The game's real exe is not in ProjectPBZ/Binaries/Win64, but in a folder per store:
  // platform/steam/PBZ.exe on Steam. UE4SS goes next to it. If another store's build names
  // it differently, the largest exe of at least 50 MB in that folder counts as the game's.
  "binariesPath": "platform/*",
  "shippingExecutable": "PBZ.exe",

  // In the install folder, with a folder per store and player inside, such as Steam/<id>.
  "saveFolder": "{Project}/Saved/SaveGames",

  // Where "How to install UE4SS" sends the user: a UE4SS release that can read this game.
  "ue4ssDownloadUrl": "https://github.com/KintaroModding/ue4ss/releases",
  "ue4ssNote": "Use the UE4SS release made for Phantom Blade Zero. It adds the files UE4SS needs to read this game's structures.",
  // The current UE4SS release per game, read at every start: one-click install and update offers.
  "ue4ssManifestUrl": "https://raw.githubusercontent.com/KintaroModding/metadata/main/uemodmanager/manifest.json",
  // Optional fallback when the manifest cannot be reached: a fixed release file and its SHA-256
  // (Get-FileHash <file>). Without either, the user picks the downloaded file.
  // "ue4ssPackageUrl": "https://github.com/KintaroModding/ue4ss/releases/download/<tag>/<file>.zip",
  // "ue4ssPackageSha256": "<sha-256 of that file>",

  // Started by "Launch game" only when the game was not found through Steam or Epic.
  // Steam starts this small exe, and it starts platform/steam/PBZ.exe.
  "executable": "steam/PBZ.exe"
}
