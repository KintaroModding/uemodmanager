<UserControl x:Class="UEManager.UI.Views.UpdateDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AppUpdateViewModel}">
    <Border Style="{StaticResource Dialog}" Width="580">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc Text.c1c1009d3f37, Tracked=True}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{Binding DialogTitle}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body}" Text="{Binding DialogText}" />

            <!-- What changed, as written on the release. -->
            <Border Margin="0,14,0,0" MaxHeight="170" Padding="14,10" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}"
                    Visibility="{Binding Notes, Converter={StaticResource VisibleIfSet}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock FontSize="12" LineHeight="18" TextWrapping="Wrap" Foreground="{StaticResource Brush.TextMuted}"
                               Text="{Binding Notes}" />
                </ScrollViewer>
            </Border>

            <!-- 1: the app updates itself. -->
            <Border Margin="0,20,0,0" Padding="18,16" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.LineStrong}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.Primary}"
                            Content="{ui:Loc Text.63bf045213ce}" ui:Icon.Glyph="&#xE896;" Command="{Binding UpdateNowCommand}"
                            IsEnabled="{Binding CanUpdateItself}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{ui:Loc Text.d461a493a375}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{Binding AutomaticText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- 2: the user downloads it. -->
            <Border Margin="0,10,0,0" Padding="18,16" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="16,0,0,0" VerticalAlignment="Center"
                            Content="{ui:Loc Text.cd6c9851e91a}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding OpenReleasePageCommand}" />
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{ui:Loc Text.573ad1256497}" />
                        <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None"
                                   Text="{Binding ManualText}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Margin="0,22,0,0" LastChildFill="False">
                <Button DockPanel.Dock="Right" Content="{ui:Loc Text.a0e63d7c7125}" Command="{Binding CloseCommand}" IsCancel="True" />
            </DockPanel>
        </StackPanel>
    </Border>
</UserControl>
