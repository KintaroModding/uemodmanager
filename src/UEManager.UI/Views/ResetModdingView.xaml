<UserControl x:Class="UEManager.UI.Views.ResetModdingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ResetModdingViewModel}">
    <!-- "Reset modding" over the whole window below the title bar, as the folder report: the question at the top, what
         it changes and the two choices that go further; below, the log of the work as it happens, with every file and
         folder it touches. Nothing changes before the click on Reset modding; the view stays open after the work until
         Close or Esc. -->
    <Border Background="{StaticResource Brush.PanelSolid}">
        <ScrollViewer Style="{StaticResource ScrollViewer.Overlay}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <DockPanel Margin="32,26,32,24">
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Start clean', Tracked=True}" />
                        <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" FontSize="22" Text="{ui:Loc 'Reset modding'}" />
                    </StackPanel>

                    <!-- The question: what the reset changes on the left, the choices and the buttons on the right. -->
                    <Grid DockPanel.Dock="Top" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                            <!-- 460 wide as before; narrower only in a window too small for it (a large interface scale). -->
                            <ColumnDefinition Width="0.9*" MaxWidth="460" />
                        </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding Intro}" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Changes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Rectangle DockPanel.Dock="Left" Width="5" Height="5" Margin="2,8,12,0" VerticalAlignment="Top"
                                               Fill="{StaticResource Brush.Accent}" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'Backups of your saves and of changed mod settings stay. Mods put straight into the game\'s Paks folder by hand are not found: for a full check, let Steam or the Epic Games Launcher verify the game files.'}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <!-- The choices are fixed once the reset starts. -->
                    <Border Padding="16,14" CornerRadius="2" BorderThickness="1" IsEnabled="{Binding IsAsking}"
                            Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding DeleteMods}" IsEnabled="{Binding HasMods}">
                                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteModsText}" />
                            </CheckBox>
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding ResetSettings}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{ui:Loc 'Also reset the app\'s settings: the game folder, sorting and other choices. The app then starts again.'}" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <!-- Before the work: Cancel or Reset modding. During it: no button, as nothing can stop it halfway.
                         After it: Close (Start again, when the app's settings were reset). -->
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IsAsking, Converter={StaticResource Visible}}">
                        <Button Content="{ui:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Reset modding'}"
                                Command="{Binding AcceptCommand}" />
                    </StackPanel>
                    <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right"
                                Visibility="{Binding IsFinished, Converter={StaticResource Visible}}">
                        <Button Content="{ui:Loc 'Keep my version'}" Command="{Binding KeepVersionCommand}"
                                Visibility="{Binding CanKeepVersion, Converter={StaticResource Visible}}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{Binding CloseText}"
                                Command="{Binding CloseCommand}" IsCancel="True" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- The work going on, what it did, or why it stopped. -->
            <Border DockPanel.Dock="Top" Margin="0,18,0,0" Padding="14,10" CornerRadius="2" BorderThickness="1"
                    Visibility="{Binding StatusText, Converter={StaticResource VisibleIfSet}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush.Field}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Line}" />
                        <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Text}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:ResetStage.Done}">
                                <Setter Property="Background" Value="{StaticResource Brush.SuccessWash}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Success}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Stage}" Value="{x:Static vm:ResetStage.Failed}">
                                <Setter Property="Background" Value="{StaticResource Brush.DangerWash}" />
                                <Setter Property="BorderBrush" Value="{StaticResource Brush.Danger}" />
                                <Setter Property="TextElement.Foreground" Value="{StaticResource Brush.Danger}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center"
                             Stroke="{StaticResource Brush.Accent}" StrokeThickness="2" StrokeDashArray="7 14" RenderTransformOrigin="0.5,0.5"
                             Visibility="{Binding IsWorking, Converter={StaticResource Visible}}">
                        <Ellipse.RenderTransform>
                            <RotateTransform />
                        </Ellipse.RenderTransform>
                        <!-- It spins only while the reset works: an endless animation keeps WPF drawing at every refresh. -->
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsWorking}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard x:Name="WorkSpin">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                     From="0" To="360" Duration="0:0:0.9" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="WorkSpin" />
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" LineHeight="19" Text="{Binding StatusText}" />
                        <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.TextMuted}"
                                   Text="{ui:Loc 'The log below shows which file or folder stopped the reset.'}"
                                   Visibility="{Binding HasFailed, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- The log's head: its name, and Copy and Save once the work is over. -->
            <DockPanel DockPanel.Dock="Top" Margin="0,20,0,0" LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Log', Tracked=True}" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                            Visibility="{Binding IsFinished, Converter={StaticResource Visible}}">
                    <Button ui:Icon.Glyph="&#xE8C8;" Content="{ui:Loc 'Copy'}" Command="{Binding CopyLogCommand}" />
                    <Button Margin="8,0,0,0" ui:Icon.Glyph="&#xE74E;" Content="{ui:Loc 'Save as .txt…'}" Command="{Binding SaveLogCommand}" />
                </StackPanel>
                <!-- What the last click did: copied, saved, or why not. -->
                <TextBlock Margin="20,0,20,0" VerticalAlignment="Center" HorizontalAlignment="Right" TextWrapping="Wrap" Text="{Binding Feedback}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextMuted}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFeedbackWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Warning}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>

            <Grid Margin="0,10,0,0" MinHeight="180">
                <Border BorderThickness="1" CornerRadius="2" Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                    <avalon:TextEditor x:Name="Viewer" Document="{Binding Document}" IsReadOnly="True" Padding="10,8"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="13" Background="Transparent"
                                       Foreground="{StaticResource Brush.Text}"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
                </Border>
                <!-- Before the work: what the log will show. -->
                <TextBlock Margin="16,12" VerticalAlignment="Top" IsHitTestVisible="False" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                           Text="{ui:Loc 'Each step of the reset shows here, with every file and folder it touches.'}"
                           Visibility="{Binding HasLog, Converter={StaticResource Hidden}}" />
            </Grid>
                </DockPanel>
            </Grid>
        </ScrollViewer>
    </Border>
</UserControl>
