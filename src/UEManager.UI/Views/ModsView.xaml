<UserControl x:Class="UEManager.UI.Views.ModsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <!-- Column widths shared by the header and every row. -->
        <GridLength x:Key="Col.Status">124</GridLength>
        <GridLength x:Key="Col.Type">92</GridLength>
        <GridLength x:Key="Col.Integrity">136</GridLength>
        <GridLength x:Key="Col.Date">104</GridLength>
        <GridLength x:Key="Col.Actions">140</GridLength>
    </UserControl.Resources>

    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Tracked 'Collection'}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="Mods" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,14" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
                <TextBlock MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Text.Body}"
                           Text="A checksum is recorded for each file the manager places in the game. Disabling a mod removes only its own files, and only while they are unchanged." />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Primary}" Content="Install from 7z/zip/rar…"
                        ui:Icon.Glyph="&#xE896;" Command="{Binding InstallFromArchiveCommand}" />
                <Button Margin="8,0,0,0" Content="Install from folder…" ui:Icon.Glyph="&#xE8B7;" Command="{Binding InstallFromFolderCommand}" />
            </StackPanel>
        </Grid>

        <!-- Search -->
        <DockPanel Margin="0,26,0,12">
            <Border DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource FieldBox}">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding ModsCountText}" />
            </Border>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="Filter: mod name, version, PAK / IoStore, or file name" />
        </DockPanel>

        <!-- Table -->
        <Border Style="{StaticResource Card}" Padding="0">
            <StackPanel>
                <Grid Margin="22,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{StaticResource Col.Status}" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource Col.Type}" />
                        <ColumnDefinition Width="{StaticResource Col.Integrity}" />
                        <ColumnDefinition Width="{StaticResource Col.Date}" />
                        <ColumnDefinition Width="{StaticResource Col.Actions}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Tracked 'Status'}" />
                    <Button Grid.Column="1" Style="{StaticResource Button.SortHeader}" Content="{ui:Tracked 'Mod'}"
                            Tag="{Binding NameSortGlyph}" ToolTip="Sort by name"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Name}" />
                    <TextBlock Grid.Column="2" Style="{StaticResource Text.Caption}" Text="{ui:Tracked 'Type'}" />
                    <TextBlock Grid.Column="3" Style="{StaticResource Text.Caption}" Text="{ui:Tracked 'Integrity'}" />
                    <Button Grid.Column="4" Style="{StaticResource Button.SortHeader}" Content="{ui:Tracked 'Installed'}"
                            Tag="{Binding InstalledSortGlyph}" ToolTip="Sort by installation date"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:ModSortField.Installed}" />
                </Grid>
                <Border Style="{StaticResource Divider}" />

                <ItemsControl ItemsSource="{Binding ModsView}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ModItemViewModel}">
                            <Border x:Name="Row" Padding="22,12" Background="Transparent"
                                    BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="{StaticResource Col.Status}" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="{StaticResource Col.Type}" />
                                        <ColumnDefinition Width="{StaticResource Col.Integrity}" />
                                        <ColumnDefinition Width="{StaticResource Col.Date}" />
                                        <ColumnDefinition Width="{StaticResource Col.Actions}" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource Toggle}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  Command="{Binding ToggleCommand}" ToolTip="Enable or disable" />
                                        <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                                                   Text="{Binding EnabledText}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   Text="{Binding Name}" ToolTip="{Binding FilesText}" />
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" Text="{Binding Detail}" />
                                    </StackPanel>

                                    <Border Grid.Column="2" Style="{StaticResource Badge}">
                                        <TextBlock FontFamily="{StaticResource Font.Label}" FontSize="11" Text="{Binding KindText}" />
                                    </Border>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center"
                                                Background="Transparent" ToolTip="{Binding IntegrityHint}">
                                        <TextBlock Style="{StaticResource Text.Icon}" FontSize="12"
                                                   Foreground="{Binding IntegrityTone, Converter={StaticResource Tone}}" Text="{Binding IntegrityGlyph}" />
                                        <TextBlock Margin="7,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                   Foreground="{Binding IntegrityTone, Converter={StaticResource Tone}}" Text="{Binding IntegrityText}" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                                               Text="{Binding InstalledText}" ToolTip="{Binding InstalledFullText}" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Margin="0,0,4,0" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE713;"
                                                Command="{Binding EditSettingsCommand}" ToolTip="{Binding EditSettingsHint}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Visibility="{Binding HasSettings, Converter={StaticResource Visible}}" />
                                        <Button Margin="0,0,4,0" Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE7A7;"
                                                Command="{Binding ResetSettingsCommand}" ToolTip="Reset the settings to the ones the mod came with"
                                                Visibility="{Binding HasSettings, Converter={StaticResource Visible}}" />
                                        <Button Style="{StaticResource Button.Icon}" ui:Icon.Glyph="&#xE838;"
                                                Command="{Binding OpenFolderCommand}" ToolTip="Open the manager's copy of this mod" />
                                        <Button Margin="4,0,0,0" Style="{StaticResource Button.IconDanger}" ui:Icon.Glyph="&#xE74D;"
                                                Command="{Binding UninstallCommand}" ToolTip="Uninstall" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{StaticResource Brush.Hover}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="0,52" HorizontalAlignment="Center"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
                    <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
                    <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyTitle}" />
                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding EmptyHint}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Files the manager did not place -->
        <Border Margin="0,16,0,0" Style="{StaticResource Card}" Padding="22,16"
                Visibility="{Binding HasUnmanaged, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Center" Content="Open mods folder"
                        ui:Icon.Glyph="&#xE838;" Command="{Binding OpenModFolderCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{Binding UnmanagedText}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}"
                               Text="The manager never changes or removes them." />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
