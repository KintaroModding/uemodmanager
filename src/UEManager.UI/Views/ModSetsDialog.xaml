<UserControl x:Class="UEManager.UI.Views.ModSetsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModSetsViewModel}">
    <Border Style="{StaticResource Dialog}" Width="680">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Mod sets', Tracked=True}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Turn on a group of mods with one click'}" />
            <TextBlock Margin="0,6,0,16" Style="{StaticResource Text.Body}"
                       Text="{ui:Loc 'A set remembers which mods are on. Using it turns exactly those mods on and all others off.'}" />

            <Border MaxHeight="320" Padding="14,6" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}"
                    Visibility="{Binding HasSets, Converter={StaticResource Visible}}" IsEnabled="{Binding CanChange}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Sets}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text}" Text="{Binding Name}" />
                                            <TextBlock Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}"
                                                       Foreground="{StaticResource Brush.Success}" Text="{ui:Loc 'In use'}"
                                                       Visibility="{Binding IsInUse, Converter={StaticResource Visible}}" />
                                        </StackPanel>
                                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap">
                                            <Run Text="{Binding CountText, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding ModsText, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" VerticalAlignment="Center" Content="{ui:Loc 'Use'}" ui:Icon.Glyph="&#xE73E;"
                                            Command="{Binding DataContext.ApplyCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{ui:Loc 'Turns exactly the mods of this set on and all others off'}" />
                                    <Button Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.IconDanger}" ui:Icon.Glyph="&#xE74D;"
                                            Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" ToolTip="{ui:Loc 'Delete the set. The mods stay as they are.'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <TextBlock Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap"
                       Visibility="{Binding HasSets, Converter={StaticResource Hidden}}"
                       Text="{ui:Loc 'No sets yet. Turn on the mods you want together, then save them as a set below.'}" />

            <TextBlock Margin="0,22,0,8" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Save the mods that are on now', Tracked=True}" />
            <DockPanel IsEnabled="{Binding CanChange}">
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Content="{ui:Loc 'Save as a set'}" ui:Icon.Glyph="&#xE74E;" Command="{Binding SaveCommand}" />
                <TextBox x:Name="NameBox" Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Tag="{ui:Loc 'Name of the set, such as Co-op or Hard mode'}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SaveCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
            <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextTrimming="None" TextWrapping="Wrap"
                       Text="{ui:Loc 'A set with the same name is replaced.'}" />

            <Grid Margin="0,20,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsAsking, Converter={StaticResource Hidden}}">
                    <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Close'}" Command="{Binding CloseCommand}" IsCancel="True" />
                </StackPanel>
                <!-- Delete asks here, in place of Close; Esc keeps the set. -->
                <DockPanel Visibility="{Binding IsAsking, Converter={StaticResource Visible}}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="{ui:Loc 'Keep the set'}" Command="{Binding KeepSetCommand}" IsCancel="True" />
                        <Button x:Name="AskDelete" Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Delete'}"
                                ui:Icon.Glyph="&#xE74D;" Command="{Binding ConfirmDeleteCommand}" />
                    </StackPanel>
                    <TextBlock VerticalAlignment="Center" Margin="0,0,16,0" Style="{StaticResource Text.Body}" TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Warning}" Text="{Binding AskText}" />
                </DockPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
