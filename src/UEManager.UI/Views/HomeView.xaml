<UserControl x:Class="UEManager.UI.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Ready your blade', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" FontSize="40" Text="{Binding GameDisplayName}" />
                <Rectangle Width="200" Height="2" Margin="0,12,0,12" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
                <TextBlock MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Text.Body}" Text="{Binding GameTagline}" />
            </StackPanel>
            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,0,0" Style="{StaticResource Badge}" Padding="10,5">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center" Fill="{Binding IsGameFound, Converter={StaticResource Tone}}" />
                    <TextBlock Margin="8,0,0,0" FontSize="12" Foreground="{Binding IsGameFound, Converter={StaticResource Tone}}"
                               Text="{Binding GameStatusText}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- The game was updated since the player last confirmed its build -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.Warning}"
                Visibility="{Binding IsGameUpdated, Converter={StaticResource Visible}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center" Content="{ui:Loc 'Got it'}"
                        ui:Icon.Glyph="&#xE73E;" Command="{Binding DismissGameUpdateCommand}" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="22" Margin="0,0,18,0"
                           Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game updated'}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding GameUpdatedText}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Game not found -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.AccentDeep}"
                Visibility="{Binding IsGameFound, Converter={StaticResource Hidden}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="{ui:Loc 'Search again'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding DetectGameCommand}" />
                    <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Locate game folder…'}"
                            ui:Icon.Glyph="&#xE838;" Command="{Binding LocateGameCommand}" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Text.Icon}" FontSize="22" Margin="0,0,18,0"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE7BA;" />
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game not found'}" />
                    <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Body}" Text="{Binding NotFoundHint}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Figures -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" Padding="0">
            <UniformGrid Columns="4">
                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="22,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Store', Tracked=True}" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Value}" Text="{Binding StoreText}" />
                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding StoreDetail}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="22,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Build', Tracked=True}" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Value}" Text="{Binding BuildText}" />
                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding BuildDetail}" />
                    </StackPanel>
                </Border>
                <Border BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0" Padding="22,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Mods installed', Tracked=True}" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Value}" Text="{Binding InstalledCount}" />
                        <TextBlock Style="{StaticResource Text.Small}" Text="{Binding EnabledText}" />
                    </StackPanel>
                </Border>
                <Border Padding="22,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Unmanaged files', Tracked=True}" />
                        <TextBlock Margin="0,8,0,4" Style="{StaticResource Text.Value}" Text="{Binding UnmanagedCount}" />
                        <TextBlock Style="{StaticResource Text.Small}" Text="{ui:Loc 'In the mods folder, left alone'}" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </Border>

        <!-- Actions -->
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Text.Icon}" FontSize="18"
                                   Foreground="{StaticResource Brush.Accent}" Text="&#xE896;" />
                        <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Quick start', Tracked=True}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Add a new mod'}" />
                    <TextBlock Margin="0,10,0,20" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc 'Drop a .zip, .7z or .rar download, a .pak file or a mod folder anywhere on this window. It is unpacked and checked before anything reaches the game.'}" />
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Install from 7z/zip/rar…'}"
                                ui:Icon.Glyph="&#xE896;" Command="{Binding InstallFromArchiveCommand}" />
                        <Button Margin="0,0,0,8" Content="{ui:Loc 'Install from folder…'}" ui:Icon.Glyph="&#xE8B7;"
                                Command="{Binding InstallFromFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="0,-6,0,-6" Padding="10,4" FontSize="12"
                                Content="{ui:Loc 'Change…'}" ui:Icon.Glyph="&#xE70F;" Command="{Binding LocateGameCommand}"
                                ToolTip="{ui:Loc 'Choose another game folder'}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Installation', Tracked=True}" />
                    </DockPanel>
                    <TextBlock Margin="0,8,0,10" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game folders'}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Install folder', Tracked=True}" />
                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Text.Path}" Text="{Binding GamePath}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Mods folder', Tracked=True}" />
                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Text.Path}" Text="{Binding ModsPath}" />
                    <TextBlock Style="{StaticResource Text.Caption}" Text="{ui:Tracked 'UE4SS'}" />
                    <StackPanel Margin="0,4,0,14" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}"
                                   Text="{Binding Ue4ssText}" />
                        <Button Margin="12,-4,0,-4" Padding="9,3" FontSize="12" Content="{ui:Loc 'Install UE4SS…'}" ui:Icon.Glyph="&#xE946;"
                                Command="{Binding ShowUe4ssGuideCommand}"
                                Visibility="{Binding IsUe4ssMissing, Converter={StaticResource Visible}}" />
                        <Button Margin="12,-4,0,-4" Padding="9,3" FontSize="12" Style="{StaticResource Button.Primary}"
                                Content="{Binding Ue4ssUpdateText}" ui:Icon.Glyph="&#xE896;" Command="{Binding UpdateUe4ssCommand}"
                                Visibility="{Binding IsUe4ssUpdateAvailable, Converter={StaticResource Visible}}" />
                    </StackPanel>
                    <WrapPanel>
                        <Button Margin="0,0,8,8" Content="{ui:Loc 'Open game folder'}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenGameFolderCommand}" />
                        <Button Margin="0,0,0,8" Content="{ui:Loc 'Open mods folder'}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenModFolderCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
