<UserControl x:Class="UEManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Tracked 'Configuration'}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="Settings" />
            <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
        </StackPanel>

        <!-- Game installation -->
        <Border Margin="0,28,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Game installation" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="Found automatically through Steam or the Epic Games Launcher. Choose the folder yourself when it was not found, or to use another copy of the game." />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Install folder'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GamePath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Found through'}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding StoreText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Build'}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding BuildText}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Locate game folder…" ui:Icon.Glyph="&#xE838;"
                            Command="{Binding LocateGameCommand}" />
                    <Button Margin="8,0,0,0" Content="Search again" ui:Icon.Glyph="&#xE72C;" Command="{Binding DetectGameCommand}" />
                    <Button Margin="8,0,0,0" Content="Open game folder" Command="{Binding OpenGameFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Save backups: off until the game profile names the save folder -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" IsEnabled="{Binding SaveBackupsAvailable}"
                ToolTip="{Binding SaveBackupsHint}" ToolTipService.ShowOnDisabled="True">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Save backups" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="A broken mod can break a save. When you turn it on below, Launch game first zips your save folder, and the manager keeps the last 5 backups. To go back to one, close the game, unzip it and copy its files over the save folder." />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Save folder'}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Path}" Text="{Binding SaveFolderText}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                   Foreground="{Binding SaveFolderTone, Converter={StaticResource Tone}}" Text="{Binding SaveFolderDetail}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Backups'}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding SaveBackupsText}" />
                </DockPanel>
                <CheckBox Margin="0,6,0,14" Content="Back up my saves each time I start the game here"
                          IsChecked="{Binding BackUpSavesOnLaunch}" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="Choose save folder…" ui:Icon.Glyph="&#xE838;"
                            Command="{Binding ChooseSaveFolderCommand}" />
                    <Button Margin="0,0,8,8" Content="Back up now" ui:Icon.Glyph="&#xE896;" Command="{Binding BackUpSavesNowCommand}" />
                    <Button Margin="0,0,8,8" Content="Open save folder" Command="{Binding OpenSaveFolderCommand}" />
                    <Button Margin="0,0,8,8" Content="Open save backups" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenSaveBackupsCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Game profile -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Game folders" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="Where the manager expects the game's files, as set by the game profile built into this app." />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Project folder'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ProjectText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Paks folder'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding PaksPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Mods folder'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Blueprint mods'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding LogicModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Game exe'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GameExeText}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Data -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="Manager data" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="The list of installed mods, the manager's copy of each mod, backups of your saves and of mod settings you changed, and the logs. All kept in the Data folder next to UEModManager.exe, so the app folder can be moved as a whole." />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Tracked 'Data folder'}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding DataPath}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="Open data folder" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenDataFolderCommand}" />
                    <Button Margin="8,0,0,0" Content="Open logs" ui:Icon.Glyph="&#xE8A5;" Command="{Binding OpenLogsCommand}" />
                    <Button Margin="8,0,0,0" Content="Open settings backups" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenBackupsCommand}"
                            ToolTip="Mod settings you changed, saved before an update or an uninstall replaced them" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Reset modding -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="Reset modding…" ui:Icon.Glyph="&#xE777;" Command="{Binding ResetModdingCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Reset modding" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="Start clean: removes every mod and UE4SS from the game, so it is back to its original files. You choose whether the mods also leave the manager." />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Help -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="Report a problem…" ui:Icon.Glyph="&#xE897;"
                            Command="{Binding ShowHelpDialogCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="Get help" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="Something does not work? Make a report for the help channel on Discord: you say what happened, the manager adds the facts a helper asks for first." />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
