<UserControl x:Class="UEManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Configuration', Tracked=True}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc 'Settings'}" />
            <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
        </StackPanel>

        <!-- Language switches the existing views immediately and persists with the other settings. -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Margin="0,-4,0,-4" Padding="10,4" FontSize="12" VerticalAlignment="Center"
                            Content="{ui:Loc 'Reset'}" Command="{Binding ResetFontSettingsCommand}"
                            ToolTip="{ui:Loc 'Reset font and interface scale to their defaults'}"
                            Visibility="{Binding CanResetFontSettings, Converter={StaticResource Visible}}" />
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Language'}" />
                </DockPanel>
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'Changes take effect immediately and are saved for the next launch.'}" />
                <DockPanel Style="{StaticResource Field}" LastChildFill="False">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Interface language'}" />
                    <ComboBox Width="240" Style="{StaticResource LanguageSelector}"
                              ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{ui:Loc 'Interface language'}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}" LastChildFill="False">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Font'}" />
                    <!-- Every installed font joins the list when it opens or takes the keyboard (see MainViewModel.Fonts). -->
                    <ComboBox Width="240" Style="{StaticResource LanguageSelector}"
                              DropDownOpened="OnFontListOpened" GotKeyboardFocus="OnFontListFocused"
                              ItemsSource="{Binding Fonts}" SelectedValuePath="Code"
                              TextSearch.TextPath="Name"
                              SelectedValue="{Binding SelectedFont, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{ui:Loc 'Font'}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type ui:FontOption}">
                                <TextBlock Text="{Binding Name}" FontFamily="{Binding PreviewFont}" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </DockPanel>
                <DockPanel LastChildFill="False">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Interface scale'}" />
                    <StackPanel Orientation="Horizontal">
                        <!-- Wait until a drag or track press ends before applying Font.Scale, so scaling does not shift the slider under the pointer. -->
                        <Slider x:Name="UiScaleSlider" Width="240" VerticalAlignment="Center"
                                Minimum="{Binding UiScaleMin}" Maximum="{Binding UiScaleMax}"
                                TickFrequency="{Binding UiScaleStep}" SmallChange="{Binding UiScaleStep}"
                                LargeChange="{Binding UiScaleStep}" IsSnapToTickEnabled="True" TickPlacement="BottomRight"
                                Value="{Binding UiScale, Mode=TwoWay, UpdateSourceTrigger=Explicit}"
                                Thumb.DragStarted="OnUiScaleDragStarted"
                                Thumb.DragCompleted="OnUiScaleDragCompleted"
                                PreviewMouseLeftButtonDown="OnUiScalePointerDown"
                                PreviewMouseLeftButtonUp="OnUiScalePointerUp"
                                LostMouseCapture="OnUiScaleLostMouseCapture"
                                MouseLeave="OnUiScaleMouseLeave"
                                PreviewKeyDown="OnUiScalePreviewKeyDown"
                                LostKeyboardFocus="OnUiScaleLostKeyboardFocus"
                                ValueChanged="OnUiScaleValueChanged"
                                AutomationProperties.Name="{ui:Loc 'Interface scale'}" />
                        <TextBlock Margin="14,0,0,0" MinWidth="44" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.Text}"
                                   Text="{Binding Value, ElementName=UiScaleSlider, StringFormat={}{0:0}%}" />
                    </StackPanel>
                </DockPanel>
                <CheckBox Margin="0,14,0,0" HorizontalAlignment="Left" Content="{ui:Loc 'Smooth scrolling'}"
                          IsChecked="{Binding SmoothScrolling}" />
            </StackPanel>
        </Border>

        <!-- The game at start: the one chosen last, or the picker at every start. Switch game changes it at any time. -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game at start'}" />
                <TextBlock Margin="0,6,0,14" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'The app starts with the game you chose last. Switch game in the title bar changes it at any time.'}" />
                <CheckBox Content="{ui:Loc 'Ask for the game at every start'}" IsChecked="{Binding AskForGameAtStart}" />
            </StackPanel>
        </Border>

        <!-- The tray icon: a click opens or minimizes the app, a right-click opens its menu. Minimize and the X hide the
             window in the tray only as the player chooses, and the X only with the icon and minimize to tray. Tray icon
             only takes the taskbar button away, and settles minimize to tray. -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Tray icon'}" />
                <TextBlock Margin="0,6,0,14" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'An icon next to the clock: a click opens or minimizes the app, a right-click opens a menu to switch or launch the game.'}" />
                <CheckBox Content="{ui:Loc 'Show tray icon'}" IsChecked="{Binding ShowTrayIcon}" />
                <CheckBox Margin="0,10,0,0" Content="{ui:Loc 'Tray icon only: no taskbar button'}" IsChecked="{Binding TrayIconOnly}"
                          IsEnabled="{Binding ShowTrayIcon}" />
                <CheckBox Margin="0,10,0,0" Content="{ui:Loc 'Minimize to tray'}" IsChecked="{Binding MinimizeToTray}"
                          IsEnabled="{Binding CanChooseMinimizeToTray}" />
                <CheckBox Margin="0,10,0,0" Content="{ui:Loc 'Close button minimizes to the tray'}" IsChecked="{Binding CloseToTray}"
                          IsEnabled="{Binding CanCloseToTray}" />
                <TextBlock Margin="0,14,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                           Text="{ui:Loc 'Windows may first put a new icon under the ^ arrow next to the clock. Drag it out to keep it in view.'}" />
            </StackPanel>
        </Border>

        <!-- Game installation -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game installation'}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'Found automatically through Steam or the Epic Games Launcher. Choose the folder yourself when it was not found, or to use another copy of the game.'}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Install folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GamePath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Found through', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding StoreText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Build', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding BuildText}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,-8">
                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Locate game folder…'}" ui:Icon.Glyph="&#xE838;"
                            Command="{Binding LocateGameCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Search again'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding DetectGameCommand}" />
                    <Button Margin="0,0,0,8" Content="{ui:Loc 'Open game folder'}" Command="{Binding OpenGameFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Mod updates: the check at start can be turned off; the button in the mod list's header works either way. -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Mod updates'}" />
                <TextBlock Margin="0,6,0,14" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'For the mods with a mod page, the app asks the mod site for the version on the page and shows when a newer one is there. It sends only the mod numbers and downloads nothing: you download the update on the mod page. The button in the mod list\'s header checks at any time.'}" />
                <CheckBox Content="{ui:Loc 'Check for mod updates at each start'}" IsChecked="{Binding CheckModUpdatesAtStart}" />
            </StackPanel>
        </Border>

        <!-- Game profile -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Game folders'}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'Where the manager expects the game\'s files, as set by the game profile built into this app.'}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Project folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ProjectText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Paks folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding PaksPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Mods folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Blueprint mods', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding LogicModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Game exe', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GameExeText}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Data -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Manager data'}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'The list of installed mods, the manager\'s copy of each mod, backups of your saves and of mod settings you changed, and the logs. All kept in the Data folder next to UEModManager.exe, so the app folder can be moved as a whole.'}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc 'Data folder', Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding DataPath}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,-8">
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Open data folder'}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenDataFolderCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Open logs'}" ui:Icon.Glyph="&#xE8A5;" Command="{Binding OpenLogsCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc 'Open settings backups'}" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenBackupsCommand}"
                            ToolTip="{ui:Loc 'Mod settings you changed, saved before an update or an uninstall replaced them'}" />
                    <!-- One click, then a message: cleared, empty already, or why not (the user's wish). -->
                    <Button Margin="0,0,0,8" Content="{ui:Loc 'Clear picture cache'}" ui:Icon.Glyph="&#xE74D;" Command="{Binding ClearPictureCacheCommand}"
                            ToolTip="{ui:Loc 'The openmods page keeps its pictures in the Data folder, so they are not downloaded at every start. Cleared pictures are downloaded again when the page shows them.'}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Reset modding -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="{ui:Loc 'Reset modding…'}" ui:Icon.Glyph="&#xE777;" Command="{Binding ResetModdingCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Reset modding'}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc 'Start clean: removes every mod and UE4SS from the game, so it is back to its original files. You choose whether the mods also leave the manager.'}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Help -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Report a problem…'}" ui:Icon.Glyph="&#xE897;"
                            Command="{Binding ShowHelpDialogCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc 'Get help'}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc 'Something does not work? Make a report for the help channel on Discord: you say what happened, the manager adds the facts a helper asks for first.'}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
