<UserControl x:Class="UEManager.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
    <UserControl.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Field" TargetType="DockPanel">
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,6,0,0">
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc Text.b332c3492d5e, Tracked=True}" />
            <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="{ui:Loc Text.74a883a037bc}" />
            <Rectangle Width="200" Height="2" Margin="0,14,0,0" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
        </StackPanel>

        <!-- Language switches the existing views immediately and persists with the other settings. -->
        <Border Margin="0,28,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.a4fe65264ef7}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc Text.f52310f5bd04}" />
                <DockPanel LastChildFill="False">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.8027f432a7fb}" />
                    <ComboBox Width="240" Style="{StaticResource LanguageSelector}"
                              ItemsSource="{Binding Languages}" DisplayMemberPath="Name" SelectedValuePath="Code"
                              SelectedValue="{Binding SelectedLanguage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              AutomationProperties.Name="{ui:Loc Text.8027f432a7fb}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Game installation -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.8aa6b308086c}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc Text.31405bb6198e}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.9c215bf11f75, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GamePath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.6c1458561521, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding StoreText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.bdd254b65baa, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding BuildText}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc Text.7d11d6748463}" ui:Icon.Glyph="&#xE838;"
                            Command="{Binding LocateGameCommand}" />
                    <Button Margin="8,0,0,0" Content="{ui:Loc Text.998195e4aaa2}" ui:Icon.Glyph="&#xE72C;" Command="{Binding DetectGameCommand}" />
                    <Button Margin="8,0,0,0" Content="{ui:Loc Text.553221725e47}" Command="{Binding OpenGameFolderCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Save backups: off until the game profile names the save folder -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}" IsEnabled="{Binding SaveBackupsAvailable}"
                ToolTip="{Binding SaveBackupsHint}" ToolTipService.ShowOnDisabled="True">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.58b1306d2f1d}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc Text.ccab6b75784a}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.2d1bffbfb103, Tracked=True}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Path}" Text="{Binding SaveFolderText}" />
                        <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                   Foreground="{Binding SaveFolderTone, Converter={StaticResource Tone}}" Text="{Binding SaveFolderDetail}" />
                    </StackPanel>
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.3334fee2c77f, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding SaveBackupsText}" />
                </DockPanel>
                <CheckBox Margin="0,6,0,14" Content="{ui:Loc Text.bbfb91c3aa91}"
                          IsChecked="{Binding BackUpSavesOnLaunch}" />
                <WrapPanel>
                    <Button Margin="0,0,8,8" Style="{StaticResource Button.Primary}" Content="{ui:Loc Text.b50188d32de7}" ui:Icon.Glyph="&#xE838;"
                            Command="{Binding ChooseSaveFolderCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc Text.02a2840b598b}" ui:Icon.Glyph="&#xE896;" Command="{Binding BackUpSavesNowCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc Text.ebc2586955c9}" Command="{Binding OpenSaveFolderCommand}" />
                    <Button Margin="0,0,8,8" Content="{ui:Loc Text.72fe99ae5201}" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenSaveBackupsCommand}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Game profile -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.33611d3d2314}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc Text.0dd4f0daa390}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.59923a31cb78, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ProjectText}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.e20badb0276b, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding PaksPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.840e19f02190, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding ModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.186fbf156248, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding LogicModsPath}" />
                </DockPanel>
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.fbe5b57eb3dd, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding GameExeText}" />
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Data -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.83395394d6a8}" />
                <TextBlock Margin="0,6,0,18" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc Text.540de3378af8}" />
                <DockPanel Style="{StaticResource Field}">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="{ui:Loc Text.3e55f576865b, Tracked=True}" />
                    <TextBlock Style="{StaticResource Text.Path}" Text="{Binding DataPath}" />
                </DockPanel>
                <WrapPanel Margin="0,10,0,0">
                    <Button Content="{ui:Loc Text.24bec7410199}" ui:Icon.Glyph="&#xE838;" Command="{Binding OpenDataFolderCommand}" />
                    <Button Margin="8,0,0,0" Content="{ui:Loc Text.591889ac42e0}" ui:Icon.Glyph="&#xE8A5;" Command="{Binding OpenLogsCommand}" />
                    <Button Margin="8,0,0,0" Content="{ui:Loc Text.c44c0f2bc813}" ui:Icon.Glyph="&#xE81C;" Command="{Binding OpenBackupsCommand}"
                            ToolTip="{ui:Loc Text.3a37ea390c0d}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Reset modding -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="{ui:Loc Text.5b90daeb2765}" ui:Icon.Glyph="&#xE777;" Command="{Binding ResetModdingCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.476de5548881}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc Text.1cd92fdd7bf2}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Help -->
        <Border Margin="0,20,0,0" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc Text.574106585e48}" ui:Icon.Glyph="&#xE897;"
                            Command="{Binding ShowHelpDialogCommand}" />
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{ui:Loc Text.fd64e81bf74d}" />
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc Text.79fe72d78397}" />
                </StackPanel>
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
