<UserControl x:Class="UEManager.UI.Views.ModDetailsDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ModDetailsViewModel}">
    <Border Style="{StaticResource Dialog}" Width="820">
        <StackPanel>
            <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Mod details', Tracked=True}" />
            <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
            <TextBlock Margin="0,6,0,16" Style="{StaticResource Text.Body}" Text="{Binding Summary}" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
                        <Setter Property="Margin" Value="0,4,16,4" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                </Grid.Resources>

                <TextBlock Text="{ui:Loc 'Installed on', Tracked=True}" />
                <TextBlock Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding InstalledText}" />

                <TextBlock Grid.Row="1" Text="{ui:Loc 'Installed from', Tracked=True}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Path}" Text="{Binding SourceText}" />

                <TextBlock Grid.Row="2" Text="{ui:Loc 'Catalog id', Tracked=True}" Visibility="{Binding CatalogId, Converter={StaticResource VisibleIfSet}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Path}" Text="{Binding CatalogId}"
                           Visibility="{Binding CatalogId, Converter={StaticResource VisibleIfSet}}" />

                <TextBlock Grid.Row="3" Text="{ui:Loc 'Size', Tracked=True}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4" Style="{StaticResource Text.Small}" Foreground="{StaticResource Brush.Text}" Text="{Binding SizeText}" />
            </Grid>

            <TextBlock Margin="0,14,0,6" Style="{StaticResource Text.Caption}" Text="{ui:Loc 'Files in the game', Tracked=True}" />
            <Border MaxHeight="300" Padding="14,8" CornerRadius="2" BorderThickness="1"
                    Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Files}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="220" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Margin="0,0,12,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="11"
                                               Foreground="{StaticResource Brush.Text}" TextTrimming="CharacterEllipsis"
                                               Text="{Binding Place}" ToolTip="{Binding FullPath}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding Size}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                                               Foreground="{Binding Tone, Converter={StaticResource Tone}}" Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <StackPanel Margin="0,20,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Close'}" Command="{Binding CloseCommand}" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
