<Window x:Class="UEManager.UI.Views.GameChoiceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:UEManager.UI"
        xmlns:views="clr-namespace:UEManager.UI.Views"
        Style="{StaticResource Window.Chrome}"
        Width="1360" Height="800"
        WindowStartupLocation="CenterScreen">

    <!-- The app at a start without a chosen game: the app's window, as large and in the same place, with the game
         picker over a blurred picture. The same picker shows over the blurred app after "Switch game". -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Background="{StaticResource Brush.TitleBar}">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Brush.Line}" />
            <StackPanel Orientation="Horizontal">
                <ContentControl Margin="13,0,0,0" Width="16" Height="16" VerticalAlignment="Center" Style="{StaticResource BrandMark}" />
                <TextBlock x:Name="AppName" Margin="9,0,0,0" VerticalAlignment="Center" FontFamily="{DynamicResource Font.Label}"
                           FontSize="12" Foreground="{StaticResource Brush.TextMuted}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.Chrome}" Content="&#xE921;" Click="OnMinimize" ToolTip="{ui:Loc 'Minimize'}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Content="&#xE922;" Click="OnMaximize" />
                <Button Style="{StaticResource Button.ChromeClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="{ui:Loc 'Close'}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ClipToBounds="True">
            <!-- Theme\Art\backdrop.jpg, a little larger than its place: a blur fades out at its edges. -->
            <Image x:Name="Backdrop" Margin="-40" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                <Image.Effect>
                    <BlurEffect Radius="8" KernelType="Gaussian" />
                </Image.Effect>
            </Image>
            <Rectangle Fill="{StaticResource Brush.BlurVeil}" />
            <!-- At a start without a chosen language, the question that offers the language of Windows comes first; the
                 picker shows once it is answered, in the language chosen. -->
            <views:GamePicker Visibility="{Binding Question, Converter={StaticResource VisibleIfNull}}" />
            <Grid Visibility="{Binding Question, Converter={StaticResource VisibleIfSet}}">
                <Border Style="{StaticResource Dialog}" Width="{Binding Width}" DataContext="{Binding Question}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}" Text="{Binding Message}" />
                        <StackPanel Margin="0,26,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
                            <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}"
                                    Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
