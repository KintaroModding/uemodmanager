<UserControl x:Class="UEManager.UI.Catalog.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ui="clr-namespace:UEManager.UI"
             xmlns:vm="clr-namespace:UEManager.UI.Catalog"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CatalogViewModel}">
    <StackPanel>

        <!-- Header -->
        <Grid Margin="0,6,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Discover', Tracked=True}" />
                <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Display}" Text="openmods" />
                <Rectangle Width="200" Height="2" Margin="0,14,0,14" HorizontalAlignment="Left" Fill="{StaticResource Brush.Stroke}" />
                <TextBlock MaxWidth="640" HorizontalAlignment="Left" Style="{StaticResource Text.Body}"
                           Text="{ui:Loc 'Open-source mods, listed by openmods.nexus. Each file comes straight from the mod\'s GitHub release and is checked before anything reaches the game.'}" />
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
                <Button Content="{ui:Loc 'Refresh'}" ui:Icon.Glyph="&#xE72C;" Command="{Binding ReloadCommand}" />
                <Button Margin="8,0,0,0" Content="{ui:Loc 'Open openmods'}" ui:Icon.Glyph="&#xE8A7;" Command="{Binding OpenSiteCommand}" />
            </StackPanel>
        </Grid>

        <!-- Test catalog from the command line -->
        <Border Margin="0,22,0,0" Padding="14,10" HorizontalAlignment="Left" CornerRadius="2" BorderThickness="1"
                Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Warning}"
                Visibility="{Binding TestCatalogText, Converter={StaticResource VisibleIfSet}}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Margin="0,1,10,0" VerticalAlignment="Top" Style="{StaticResource Text.Icon}"
                           FontSize="13" Foreground="{StaticResource Brush.Warning}" Text="&#xE7BA;" />
                <TextBlock TextWrapping="Wrap" LineHeight="19" Foreground="{StaticResource Brush.Warning}" Text="{Binding TestCatalogText}" />
            </DockPanel>
        </Border>

        <!-- Not loaded -->
        <Border Margin="0,22,0,0" Style="{StaticResource Card}" BorderBrush="{StaticResource Brush.AccentDeep}"
                Visibility="{Binding Error, Converter={StaticResource VisibleIfSet}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Margin="20,0,0,0" VerticalAlignment="Center" Content="{ui:Loc 'Try again'}"
                        ui:Icon.Glyph="&#xE72C;" Command="{Binding ReloadCommand}" />
                <TextBlock DockPanel.Dock="Left" Margin="0,0,16,0" Style="{StaticResource Text.Icon}" FontSize="18"
                           Foreground="{StaticResource Brush.Accent}" Text="&#xE7BA;" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontWeight="SemiBold" Text="{ui:Loc 'The openmods list is not available right now'}" />
                    <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap" TextTrimming="None" Text="{Binding Error}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <TextBlock Margin="0,52" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{ui:Loc 'Loading the openmods list…'}"
                   Visibility="{Binding IsLoading, Converter={StaticResource Visible}}" />

        <!-- Search and sort -->
        <DockPanel Margin="0,26,0,0" Visibility="{Binding HasItems, Converter={StaticResource Visible}}">
            <!-- A field like the search box, so the sort buttons and the count stay readable over the cover art. -->
            <Border DockPanel.Dock="Right" Margin="10,0,0,0" Style="{StaticResource FieldBox}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button VerticalAlignment="Center" Style="{StaticResource Button.SortHeader}"
                            Content="{ui:Loc 'Name', Tracked=True}" Tag="{Binding NameSortGlyph}" ToolTip="{ui:Loc 'Sort by name'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:CatalogSortField.Name}" />
                    <Button Margin="18,0,0,0" VerticalAlignment="Center" Style="{StaticResource Button.SortHeader}"
                            Content="{ui:Loc 'Updated', Tracked=True}" Tag="{Binding UpdatedSortGlyph}" ToolTip="{ui:Loc 'Sort by the date of the latest release'}"
                            Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:CatalogSortField.Updated}" />
                    <Rectangle Width="1" Height="16" Margin="16,0" VerticalAlignment="Center" Fill="{StaticResource Brush.LineStrong}" />
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding CountText}" />
                </StackPanel>
            </Border>
            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Tag="{ui:Loc 'Filter: mod name, author, tag or description'}" />
        </DockPanel>

        <!-- Nothing matches the search -->
        <StackPanel Margin="0,52" HorizontalAlignment="Center" Visibility="{Binding ShowNoMatch, Converter={StaticResource Visible}}">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{ui:Loc 'No mods match the search'}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="{ui:Loc 'Try another name, author or tag.'}" />
        </StackPanel>

        <!-- Nothing listed for this game -->
        <StackPanel Margin="0,52" HorizontalAlignment="Center" Visibility="{Binding ShowEmpty, Converter={StaticResource Visible}}">
            <ContentControl Style="{StaticResource BrandMark}" Width="40" Height="40" Opacity="0.5" />
            <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Title}" Text="{Binding EmptyText}" />
            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}"
                       Text="{ui:Loc 'New mods show up here as soon as openmods lists them.'}" />
        </StackPanel>

        <!-- Mods -->
        <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding ItemsView}" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:CatalogItemViewModel}">
                    <Border Margin="0,0,0,12" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Cover: 16:9 at least, and always the full height of the card (cropped when the card is
                                 taller). The game's picture when the mod has none. -->
                            <Border Width="256" MinHeight="144" Margin="1" ClipToBounds="True" Background="{StaticResource Brush.Field}">
                                <Image Source="{Binding Cover}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>

                            <StackPanel Grid.Column="1" Margin="22,14,16,14">
                                <TextBlock Style="{StaticResource Text.Title}" FontSize="17" Text="{Binding Name}" />
                                <TextBlock Margin="0,6,0,0" FontSize="12.5" LineHeight="18" TextWrapping="Wrap"
                                           Foreground="{StaticResource Brush.TextMuted}" Text="{Binding Summary}"
                                           Visibility="{Binding Summary, Converter={StaticResource VisibleIfSet}}" />
                                <WrapPanel Margin="0,10,0,0">
                                    <ItemsControl ItemsSource="{Binding Tags}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,6,0" Style="{StaticResource Badge}">
                                                    <TextBlock FontFamily="{StaticResource Font.Label}" FontSize="11" Text="{Binding}" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Small}" Text="{Binding MetaText}" />
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Width="190" Margin="0,14,22,14">
                                <Button Style="{StaticResource Button.Primary}" Content="{Binding ActionText}" ui:Icon.Glyph="&#xE896;"
                                        Command="{Binding ActCommand}" Visibility="{Binding HasAction, Converter={StaticResource Visible}}" />
                                <StackPanel Margin="0,6,0,0" HorizontalAlignment="Center" Orientation="Horizontal"
                                            Visibility="{Binding StatusText, Converter={StaticResource VisibleIfSet}}">
                                    <TextBlock Margin="0,0,6,0" Style="{StaticResource Text.Icon}" FontSize="12"
                                               Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" Text="{Binding StatusGlyph}" />
                                    <TextBlock FontSize="12" VerticalAlignment="Center"
                                               Foreground="{Binding StatusTone, Converter={StaticResource Tone}}" Text="{Binding StatusText}" />
                                </StackPanel>
                                <StackPanel Margin="0,10,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
                                    <Button Padding="8,3" FontSize="12" Content="{ui:Loc 'Page'}" ui:Icon.Glyph="&#xE774;" Command="{Binding OpenPageCommand}"
                                            Visibility="{Binding HasPage, Converter={StaticResource Visible}}"
                                            ToolTip="{ui:Loc 'The mod\'s page on openmods, with its full description'}" />
                                    <Button Margin="6,0,0,0" Padding="8,3" FontSize="12" Content="{ui:Loc 'Source'}" ui:Icon.Glyph="&#xE943;"
                                            Command="{Binding OpenSourceCommand}" Visibility="{Binding HasSource, Converter={StaticResource Visible}}"
                                            ToolTip="{Binding Mod.Source}" />
                                </StackPanel>
                                <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Text="{Binding AuthorText}" ToolTip="{Binding AuthorText}" />
                                <TextBlock Margin="0,2,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Small}"
                                           Text="{Binding ListedByText}" ToolTip="{Binding ListedByText}"
                                           Visibility="{Binding ListedByText, Converter={StaticResource VisibleIfSet}}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
