<Window x:Class="UEManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="clr-namespace:UEManager.UI"
        xmlns:views="clr-namespace:UEManager.UI.Views"
        xmlns:vm="clr-namespace:UEManager.UI.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="{Binding WindowTitle}"
        Language="{Binding SelectedLanguage, ConverterCulture=en-US}"
        Width="1360" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Ink}"
        BorderBrush="{StaticResource Brush.LineStrong}"
        BorderThickness="1"
        Foreground="{StaticResource Brush.Text}"
        FontFamily="{StaticResource Font.Body}"
        FontSize="13"
        UseLayoutRounding="True"
        AllowDrop="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== Title bar: drag to move, double-click to maximize ===== -->
        <Grid Background="{StaticResource Brush.TitleBar}">
            <Rectangle Height="1" VerticalAlignment="Bottom" Fill="{StaticResource Brush.Line}" />
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontFamily="{StaticResource Font.Label}" FontSize="12"
                       Foreground="{StaticResource Brush.TextMuted}" Text="{Binding AppName}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource Button.Chrome}" Content="&#xE921;" Click="OnMinimize" ToolTip="{ui:Loc 'Minimize'}" />
                <Button x:Name="MaximizeButton" Style="{StaticResource Button.Chrome}" Content="&#xE922;" Click="OnMaximize" ToolTip="{ui:Loc 'Maximize'}" />
                <Button Style="{StaticResource Button.ChromeClose}" Content="&#xE8BB;" Click="OnClose" ToolTip="{ui:Loc 'Close'}" />
            </StackPanel>
        </Grid>

        <!-- Without cover art: a faint cinnabar bloom, like ink spreading on paper. -->
        <Ellipse Grid.Row="1" Width="1100" Height="820" HorizontalAlignment="Right" VerticalAlignment="Top"
                 Margin="0,-420,-360,0" IsHitTestVisible="False"
                 Visibility="{Binding Art.HasBackground, Converter={StaticResource Hidden}}">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#30C8102E" Offset="0" />
                    <GradientStop Color="#0CC8102E" Offset="0.55" />
                    <GradientStop Color="#00C8102E" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Sidebar ===== -->
            <Border Background="{StaticResource Brush.Sidebar}" BorderBrush="{StaticResource Brush.Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="28,20,24,28">
                        <!-- The emblem: Theme\Art\logo.png when built in, else the drawn mark. -->
                        <Grid Width="60" Height="60" HorizontalAlignment="Left">
                            <Image Source="{Binding Art.Logo}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding Art.HasLogo, Converter={StaticResource Visible}}" />
                            <ContentControl Style="{StaticResource BrandMark}" Margin="0,8,16,8"
                                            Visibility="{Binding Art.HasLogo, Converter={StaticResource Hidden}}" />
                        </Grid>
                        <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Title}" FontSize="16" LineHeight="22"
                                   Text="{Binding GameDisplayName, Converter={StaticResource Tracked}}" />
                        <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Overline}" FontSize="10"
                                   Text="{ui:Loc 'Mod manager', Tracked=True}" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="24,0,24,22">
                        <Button Margin="0,0,0,10" Style="{StaticResource Button.Discord}" Content="{ui:Loc 'Join our Discord'}"
                                Command="{Binding OpenDiscordCommand}" ToolTip="{ui:Loc 'Questions, news and help: the community on Discord'}" />
                        <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Launch game'}" ui:Icon.Glyph="&#xE768;"
                                Command="{Binding LaunchGameCommand}" Padding="14,11" />
                        <Border Style="{StaticResource Divider}" Margin="0,20,0,14" />
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{Binding IsGameFound, Converter={StaticResource Tone}}" />
                            <TextBlock Margin="9,0,0,0" Style="{StaticResource Text.Small}" Text="{Binding GameStatusText}" />
                        </StackPanel>
                        <TextBlock Margin="16,4,0,0" FontSize="11" Foreground="{StaticResource Brush.TextDim}"
                                   Text="{Binding AppVersionText}" />
                        <!-- The update check: green when up to date; orange, and a click opens the update, when not.
                             After the banner for a new version, the box flashes once. -->
                        <Grid Margin="0,12,0,0" DataContext="{Binding Update}">
                            <Button Style="{StaticResource Button.StatusBox}"
                                    Command="{Binding ShowCommand}" IsEnabled="{Binding IsAvailable}" ToolTip="{Binding StatusHint}"
                                    ToolTipService.ShowOnDisabled="True"
                                    Foreground="{Binding StatusTone, Converter={StaticResource Tone}}"
                                    BorderBrush="{Binding StatusTone, Converter={StaticResource Tone}}"
                                    Background="{Binding StatusTone, Converter={StaticResource Tone}, ConverterParameter=wash}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="{Binding StatusGlyph}" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{Binding StatusText}" />
                                </StackPanel>
                            </Button>
                            <Border CornerRadius="2" IsHitTestVisible="False" Opacity="0" Background="{StaticResource Brush.Warning}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="0" Color="#D9A84E" />
                                </Border.Effect>
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="0.5"
                                                                             Duration="0:0:0.35" AutoReverse="True" FillBehavior="Stop" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                        </Grid>
                    </StackPanel>

                    <!-- Scrolls when the window is too low for every entry, so none hides behind the buttons below. -->
                    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <RadioButton Style="{StaticResource NavItem}" Content="{ui:Loc 'Home'}" ui:Icon.Glyph="&#xE80F;"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Home}" />
                            <RadioButton Style="{StaticResource NavItem}" Content="{ui:Loc 'Mods'}" ui:Icon.Glyph="&#xE8F1;"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Mods}" />
                            <RadioButton Style="{StaticResource NavItem}" Content="UE4SS" ui:Icon.Glyph="&#xE943;"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Ue4ss}" />
                            <!-- Filled by Catalog\CatalogResources.xaml in a build with the catalog only. -->
                            <ContentControl Focusable="False" Content="{DynamicResource CatalogNavItem}" />
                            <RadioButton Style="{StaticResource NavItem}" Content="{ui:Loc 'Settings'}" ui:Icon.Glyph="&#xE713;"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Settings}" />
                            <RadioButton Style="{StaticResource NavItem}" Content="{ui:Loc 'About'}" ui:Icon.Glyph="&#xE946;"
                                         IsChecked="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=About}" />
                            <!-- A pre-release build says so; a click explains what that means. -->
                            <Button Margin="24,14,24,0" Style="{StaticResource Button.StatusBox}" ToolTip="{ui:Loc 'What a pre-release means'}"
                                    Visibility="{Binding IsPreRelease, Converter={StaticResource Visible}}"
                                    Command="{Binding ShowPreReleaseCommand}"
                                    Foreground="{StaticResource Brush.Warning}" BorderBrush="{StaticResource Brush.Warning}"
                                    Background="{StaticResource Brush.WarningWash}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Icon}" FontSize="12" Text="&#xE7BA;" />
                                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" FontSize="12" Text="{ui:Loc 'Pre-release'}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- ===== Content ===== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="16" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Cover art (Theme\Art\background.jpg): anchored top right, fading into ink toward the
                     lower left. The fades are ink layers painted over the image. -->
                <Grid Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Image Source="{Binding Art.Background}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <Rectangle Visibility="{Binding Art.HasBackground, Converter={StaticResource Visible}}">
                        <Rectangle.Fill>
                            <RadialGradientBrush Center="1,0" GradientOrigin="1,0" RadiusX="0.95" RadiusY="1.5">
                                <GradientStop Color="#000B0A0A" Offset="0" />
                                <GradientStop Color="#000B0A0A" Offset="0.4" />
                                <GradientStop Color="#FF0B0A0A" Offset="1" />
                            </RadialGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <!-- Softens the bottom edge into the window background. -->
                    <Rectangle Visibility="{Binding Art.HasBackground, Converter={StaticResource Visible}}">
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#000B0A0A" Offset="0.55" />
                                <GradientStop Color="#FF0B0A0A" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                </Grid>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid MaxWidth="1120" Margin="48,0,48,28">
                        <views:HomeView Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Home}" />
                        <views:ModsView Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Mods}" />
                        <views:Ue4ssView Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Ue4ss}" />
                        <ContentControl Focusable="False" Content="{DynamicResource CatalogPage}"
                                        Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Catalog}" />
                        <views:SettingsView Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=Settings}" />
                        <views:AboutView Visibility="{Binding SelectedPage, Converter={StaticResource Page}, ConverterParameter=About}" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- ===== Message ===== -->
        <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,28" MaxWidth="480"
                Background="{StaticResource Brush.PanelSolid}" BorderBrush="{StaticResource Brush.LineStrong}"
                BorderThickness="1" CornerRadius="2"
                Visibility="{Binding Toast, Converter={StaticResource VisibleIfSet}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="0" Opacity="0.6" Color="Black" />
            </Border.Effect>
            <DockPanel>
                <Rectangle DockPanel.Dock="Left" Width="3"
                           Fill="{Binding Toast.Tone, Converter={StaticResource Tone}, FallbackValue=Transparent}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource Button.Icon}" Content="&#xE711;" FontFamily="{StaticResource Font.Icons}"
                        FontSize="10" Width="28" Height="28" Margin="6" VerticalAlignment="Top"
                        Command="{Binding DismissToastCommand}" ToolTip="{ui:Loc 'Dismiss'}" />
                <TextBlock Margin="16,12,4,12" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="19"
                           Text="{Binding Toast.Text}" />
            </DockPanel>
        </Border>

        <!-- ===== New version: a short banner, once per version; dialogs open over it ===== -->
        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                DataContext="{Binding Update}" Padding="24,18,30,18" CornerRadius="2" BorderThickness="1"
                Background="{StaticResource Brush.PanelSolid}" BorderBrush="{StaticResource Brush.Warning}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.7" Color="Black" />
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Opacity" Value="0" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsBannerVisible}" Value="True">
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                        </ObjectAnimationUsingKeyFrames>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.3" />
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0:0:0.3" Value="{x:Static Visibility.Collapsed}" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource Text.Icon}" FontSize="24" VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Warning}" Text="{Binding StatusGlyph}" />
                <StackPanel Margin="18,0,0,0">
                    <TextBlock Style="{StaticResource Text.Title}" Text="{Binding BannerTitle}" />
                    <TextBlock Margin="0,5,0,0" Style="{StaticResource Text.Small}"
                               Text="{ui:Loc 'Click the orange box at the bottom left to update.'}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ===== Drop target ===== -->
        <Grid Grid.Row="1" Background="#E00B0A0A" IsHitTestVisible="False"
              Visibility="{Binding IsDragOver, Converter={StaticResource Visible}}">
            <Rectangle Margin="28" Stroke="{StaticResource Brush.Accent}" StrokeThickness="1.5"
                       StrokeDashArray="6 4" RadiusX="2" RadiusY="2" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Text.Icon}" Text="&#xE896;" FontSize="42"
                           HorizontalAlignment="Center" Foreground="{StaticResource Brush.Accent}" />
                <TextBlock Margin="0,18,0,0" Style="{StaticResource Text.Display}" FontSize="28"
                           HorizontalAlignment="Center" Text="{ui:Loc 'Drop to install'}" />
                <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Body}" HorizontalAlignment="Center"
                           Text="{ui:Loc '.zip  ·  .7z  ·  .rar  ·  .pak  ·  .utoc  ·  .ucas  ·  folders'}" />
            </StackPanel>
        </Grid>

        <!-- ===== Install review ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding InstallDialog, Converter={StaticResource VisibleIfSet}}">
            <views:InstallDialog DataContext="{Binding InstallDialog}" Margin="40" />
        </Grid>

        <!-- ===== UE4SS install guide (can open over the install review) ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding Ue4ssGuide, Converter={StaticResource VisibleIfSet}}">
            <views:Ue4ssGuide DataContext="{Binding Ue4ssGuide}" Margin="40" />
        </Grid>

        <!-- ===== Update ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding Update.IsDialogOpen, Converter={StaticResource Visible}}">
            <views:UpdateDialog DataContext="{Binding Update}" Margin="40" />
        </Grid>

        <!-- ===== Pre-release ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding IsPreReleaseDialogOpen, Converter={StaticResource Visible}}">
            <Border Style="{StaticResource Dialog}" Width="480">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'About this version', Tracked=True}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Pre-release'}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}"
                               Text="{ui:Loc 'UE MM is at the beginning of its development. This version most likely works. If something does not, an update with a fix follows quickly.&#10;&#10;Either way, expect frequent changes: features, screens and texts can still change from one version to the next.'}" />
                    <StackPanel Margin="0,26,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Got it'}"
                                Command="{Binding ClosePreReleaseCommand}" IsCancel="True" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Report a problem ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding HelpDialog, Converter={StaticResource VisibleIfSet}}">
            <views:HelpReportDialog DataContext="{Binding HelpDialog}" Margin="40" />
        </Grid>

        <!-- ===== Reset modding ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding ResetDialog, Converter={StaticResource VisibleIfSet}}">
            <Border Style="{StaticResource Dialog}" Width="560" DataContext="{Binding ResetDialog}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Overline}" Text="{ui:Loc 'Start clean', Tracked=True}" />
                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Text.Title}" Text="{ui:Loc 'Reset modding'}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}" Text="{Binding Intro}" />
                    <ItemsControl Margin="0,14,0,0" ItemsSource="{Binding Changes}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Rectangle DockPanel.Dock="Left" Width="5" Height="5" Margin="2,8,12,0" VerticalAlignment="Top"
                                               Fill="{StaticResource Brush.Accent}" />
                                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding}" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Margin="0,6,0,0" Style="{StaticResource Text.Small}" TextWrapping="Wrap"
                               Text="{ui:Loc 'Backups of your saves and of changed mod settings stay. Mods put straight into the game\'s Paks folder by hand are not found: for a full check, let Steam or the Epic Games Launcher verify the game files.'}" />
                    <Border Margin="0,18,0,0" Padding="16,14" CornerRadius="2" BorderThickness="1"
                            Background="{StaticResource Brush.Field}" BorderBrush="{StaticResource Brush.Line}">
                        <StackPanel>
                            <CheckBox IsChecked="{Binding DeleteMods}" IsEnabled="{Binding HasMods}">
                                <TextBlock TextWrapping="Wrap" Text="{Binding DeleteModsText}" />
                            </CheckBox>
                            <CheckBox Margin="0,12,0,0" IsChecked="{Binding ResetSettings}">
                                <TextBlock TextWrapping="Wrap"
                                           Text="{ui:Loc 'Also reset the app\'s settings: the game folder, sorting and other choices. The app then starts again.'}" />
                            </CheckBox>
                        </StackPanel>
                    </Border>
                    <StackPanel Margin="0,24,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{ui:Loc 'Cancel'}" Command="{Binding CancelCommand}" IsCancel="True" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}" Content="{ui:Loc 'Reset modding'}"
                                Command="{Binding AcceptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Confirmation ===== -->
        <Grid Grid.Row="1" Background="{StaticResource Brush.Overlay}"
              Visibility="{Binding Confirm, Converter={StaticResource VisibleIfSet}}">
            <Border Style="{StaticResource Dialog}" Width="480" DataContext="{Binding Confirm}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" />
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource Text.Body}" Text="{Binding Message}" />
                    <StackPanel Margin="0,26,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="{Binding CancelText}" Command="{Binding CancelCommand}" />
                        <Button Margin="8,0,0,0" Style="{StaticResource Button.Primary}"
                                Content="{Binding ConfirmText}" Command="{Binding AcceptCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===== Busy ===== -->
        <Grid Grid.RowSpan="2" Background="#B0070606" Visibility="{Binding IsBusy, Converter={StaticResource Visible}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse Width="34" Height="34" Stroke="{StaticResource Brush.Accent}" StrokeThickness="2.5"
                         StrokeDashArray="14 30" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.9" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <TextBlock Margin="0,16,0,0" HorizontalAlignment="Center" Style="{StaticResource Text.Body}"
                           Text="{Binding BusyText}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
